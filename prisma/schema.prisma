  fileName      String?
  fileSize      Int?
  fileType      String? // 'image', 'audio', 'video', 'document', 'voice'
  audioDuration Int? // в секундах
  audioUrl      String? // URL аудиофайла голосового сообщения
  waveform      String? // JSON массив амплитуд для визуализации волны
  isPinned      Boolean   @default(false)
  expiresAt     DateTime? // для самоуничтожающихся сообщений
  editedAt      DateTime?
  deletedAt     DateTime?
  replyToId     Int?
  replyTo       Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[] @relation("MessageReplies")

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId Int
  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  reactions    Reaction[]
  readReceipts MessageReadReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pinnedInConversation Conversation? @relation("ConversationPinnedMessage")

  @@index([conversationId, createdAt])
}

// =============== ЧТЕНИЕ СООБЩЕНИЙ ===============
model MessageReadReceipt {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// =============== РЕАКЦИИ ===============
model Reaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

// =============== СЕРВЕРЫ (COMMUNITIES) ===============
model Server {
  id         Int      @id @default(autoincrement())
  name       String
  icon       String?
  ownerId    Int
  owner      User     @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  inviteCode String   @unique @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  channels Conversation[]
  members  ServerMember[]
}

model ServerMember {
  id        Int      @id @default(autoincrement())
  userId    Int
  serverId  Int
  role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  roleName  String?  @default("Участник")
  roleColor String?  @default("#94a3b8")
  joinedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
}

enum ConvType {
  DIRECT // 1 на 1
  GROUP // групповой чат
  SERVER_CHANNEL // канал на сервере
  SERVER_VOICE // голосовой канал
}

//
// log.prisma
//

model ClientErrorLog {
  id        String   @id @default(ulid())
  userId    Int?
  userEmail String?
  source    String // "webrtc", "webrtc_mic", "socket", "react", "unhandled_rejection", "api"
  message   String
  stack     String?  @db.Text
  context   Json? // { browser, os, device, conversationId, iceState, transportState, etc. }
  url       String?
  createdAt DateTime @default(now())

  @@index([source])
  @@index([createdAt])
  @@map("client_error_logs")
}

//
// schema.prisma
//

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

//
// user.prisma
//

enum FriendStatus {
  PENDING // Запрос отправлен, ждёт подтверждения
  ACCEPTED // Друзья
  BLOCKED // В чёрном списке (опционально)
}

// 👇 Добавляем после модели User
model Friend {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderId   Int
  receiverId Int
  status     FriendStatus @default(PENDING)

  sender   User @relation("friendSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("friendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  // Уникальная пара пользователей (в любом направлении)
  @@unique([senderId, receiverId])
  @@index([status])
  @@map("friends")
}

model User {
  id                       Int       @id @default(autoincrement())
  email                    String    @unique
  username                 String    @unique
  password                 String? // 👈 Сделали опциональным для OAuth пользователей
  name                     String? // 👈 Сделали опциональным на случай пустых данных из соцсети
  surname                  String? // 👈 Сделали опциональным
  avatar                   String? // URL аватара пользователя
  lastSeenAt               DateTime? // Время последнего онлайна
  twoFactorSecret          String? // Секрет TOTP 2FA
  twoFactorEnabled         Boolean   @default(false)
  isEmailVerified          Boolean   @default(false)
  emailVerificationCode    String?
  emailVerificationExpires DateTime?
  pendingNewEmail          String?
  pendingEmailCode         String?
  pendingEmailExpires      DateTime?
  customStatus             String? // Текстовый статус
  statusEmoji              String? // Эмодзи статуса
  theme                    String?   @default("dark")
  createdAt                DateTime  @default(now())

  // Твои связи
  conversationMemberships ConversationMember[]
  ownedConversations      Conversation[]
  sentMessages            Message[]            @relation("SentMessages")
  friendsSent             Friend[]             @relation("friendSender")
  friendsReceived         Friend[]             @relation("friendReceiver")

  // Серверы
  ownedServers      Server[]       @relation("ServerOwner")
  serverMemberships ServerMember[]

  // Реакции
  reactions    Reaction[]
  readReceipts MessageReadReceipt[]

  // Сессии
  sessions UserSession[]

  // 🔹 Новая связь для масштабирования соцсетей
  socialAccounts SocialAccount[]

  // 🔹 Токены устройств для Push-уведомлений
  deviceTokens DeviceToken[]

  @@map("users")
}

model UserSession {
  id         Int      @id @default(autoincrement())
  userId     Int
  token      String
  ip         String?
  userAgent  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model SocialAccount {
  id         Int      @id @default(autoincrement())
  userId     Int
  provider   String // Сюда будет сохраняться "YANDEX"
  providerId String // ID пользователя в самом Яндексе
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("social_accounts")
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  platform  String? // 'web', 'android', 'desktop'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
