enum FriendStatus {
  PENDING // Запрос отправлен, ждёт подтверждения
  ACCEPTED // Друзья
  BLOCKED // В чёрном списке (опционально)
}

// 👇 Добавляем после модели User
model Friend {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  senderId   Int
  receiverId Int
  status     FriendStatus @default(PENDING)

  sender   User @relation("friendSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("friendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  // Уникальная пара пользователей (в любом направлении)
  @@unique([senderId, receiverId])
  @@index([status])
  @@map("friends")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  username          String    @unique
  password          String? // 👈 Сделали опциональным для OAuth пользователей
  name              String? // 👈 Сделали опциональным на случай пустых данных из соцсети
  surname           String? // 👈 Сделали опциональным
  avatar            String? // URL аватара пользователя
  lastSeenAt        DateTime? // Время последнего онлайна
  twoFactorSecret   String? // Секрет TOTP 2FA
  twoFactorEnabled          Boolean   @default(false)
  isEmailVerified           Boolean   @default(false)
  emailVerificationCode     String?
  emailVerificationExpires  DateTime?
  pendingNewEmail           String?
  pendingEmailCode          String?
  pendingEmailExpires       DateTime?
  customStatus              String? // Текстовый статус
  statusEmoji               String? // Эмодзи статуса
  theme                     String?   @default("dark")
  createdAt                 DateTime  @default(now())

  // Твои связи
  conversationMemberships ConversationMember[]
  ownedConversations      Conversation[]
  sentMessages            Message[]            @relation("SentMessages")
  friendsSent             Friend[]             @relation("friendSender")
  friendsReceived         Friend[]             @relation("friendReceiver")

  // Серверы
  ownedServers       Server[]       @relation("ServerOwner")
  serverMemberships  ServerMember[]

  // Реакции
  reactions Reaction[]
  readReceipts MessageReadReceipt[]

  // Сессии
  sessions UserSession[]

  // 🔹 Новая связь для масштабирования соцсетей
  socialAccounts SocialAccount[]

  // 🔹 Токены устройств для Push-уведомлений
  deviceTokens DeviceToken[]

  @@map("users")
}

model UserSession {
  id         Int      @id @default(autoincrement())
  userId     Int
  token      String
  ip         String?
  userAgent  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model SocialAccount {
  id         Int      @id @default(autoincrement())
  userId     Int
  provider   String // Сюда будет сохраняться "YANDEX"
  providerId String // ID пользователя в самом Яндексе
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("social_accounts")
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  platform  String? // 'web', 'android', 'desktop'
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
