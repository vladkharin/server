model Conversation {
    id        Int      @id @default(autoincrement())
    type      ConvType @default(DIRECT) // DIRECT, GROUP, SERVER_CHANNEL
    name      String? // null для DIRECT, обязательно для GROUP/SERVER
    avatar    String? // URL аватара чата
    ownerId   Int? // только для GROUP/SERVER (создатель)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Тема, категория и настройки канала
    topic          String? // Описание/тема канала
    category       String?   @default("ОБЩИЕ") // Категория/группа каналов
    slowmode       Int       @default(0) // Задержка между сообщениями в секундах (0 = выключено)
    isAnnouncement Boolean   @default(false) // Только администраторы могут писать
    isPrivate      Boolean   @default(false) // Доступ только по ролям/приглашению

    // Для DIRECT: хэш вида "minId-maxId" → гарантирует уникальность пары
    dmHash String? @unique

    // Закрепленное сообщение
    pinnedMessageId Int?     @unique
    pinnedMessage   Message? @relation("ConversationPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)

    // Привязка к серверу (для SERVER_CHANNEL)
    serverId Int?
    server   Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

    // Связи
    owner    User?                @relation(fields: [ownerId], references: [id])
    members  ConversationMember[]
    messages Message[]

    callActive    Boolean   @default(false)
    callStartedAt DateTime?
}

// =============== УЧАСТНИКИ ЧАТА ===============
model ConversationMember {
    id             Int       @id @default(autoincrement())
    userId         Int
    conversationId Int
    joinedAt       DateTime  @default(now())
    lastReadAt     DateTime? // для отметки прочитанных сообщений
    isOwner        Boolean   @default(false)
    username       String? // персональное имя в чате (как в Discord)

    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@unique([userId, conversationId])
}

// =============== СООБЩЕНИЯ ===============
model Message {
    id             Int       @id @default(autoincrement())
    content        String
    imageUrl       String?
    fileUrl        String?
    fileName       String?
    fileSize       Int?
    fileType       String? // 'image', 'audio', 'video', 'document', 'voice'
    audioDuration  Int? // в секундах
    audioUrl       String? // URL аудиофайла голосового сообщения
    waveform       String? // JSON массив амплитуд для визуализации волны
    isPinned       Boolean   @default(false)
    expiresAt      DateTime? // для самоуничтожающихся сообщений
    editedAt       DateTime?
    deletedAt      DateTime?
    replyToId      Int?
    replyTo        Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
    replies        Message[] @relation("MessageReplies")

    conversationId Int
    conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    senderId Int
    sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

    reactions    Reaction[]
    readReceipts MessageReadReceipt[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    pinnedInConversation Conversation? @relation("ConversationPinnedMessage")

    @@index([conversationId, createdAt])
}

// =============== ЧТЕНИЕ СООБЩЕНИЙ ===============
model MessageReadReceipt {
    id        Int      @id @default(autoincrement())
    messageId Int
    userId    Int
    readAt    DateTime @default(now())

    message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([messageId, userId])
}

// =============== РЕАКЦИИ ===============
model Reaction {
    id        Int      @id @default(autoincrement())
    messageId Int
    userId    Int
    message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    emoji     String
    createdAt DateTime @default(now())

    @@unique([messageId, userId, emoji])
}

// =============== СЕРВЕРЫ (COMMUNITIES) ===============
model Server {
    id         Int      @id @default(autoincrement())
    name       String
    icon       String?
    ownerId    Int
    owner      User     @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
    inviteCode String   @unique @default(uuid())
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    channels Conversation[]
    members  ServerMember[]
}

model ServerMember {
    id        Int      @id @default(autoincrement())
    userId    Int
    serverId  Int
    role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER
    roleName  String?  @default("Участник")
    roleColor String?  @default("#94a3b8")
    joinedAt  DateTime @default(now())

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

    @@unique([userId, serverId])
}

enum ConvType {
    DIRECT // 1 на 1
    GROUP // групповой чат
    SERVER_CHANNEL // канал на сервере
    SERVER_VOICE // голосовой канал
}
